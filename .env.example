# Z Supabase: Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# WebAdmin (Laravel) — concierge AI. V `npm run dev` se `/api/concierge/guest` proxyuje sem.
VITE_WEBADMIN_URL=http://127.0.0.1:8000

# V produkci nechej prázdné, aby se volalo relativně (stejný origin / reverse proxy).
# VITE_CONCIERGE_API_BASE=

VITE_HOTEL_SLUG=default
VITE_HOTEL_LAT=50.0875
VITE_HOTEL_LNG=14.4213

# Odkazy na nativní appku (prázdné = tlačítka se skryjí, zůstane landing)
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
